<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.deriva.ui.fx.EmSettingsController"
      styleClass="content" spacing="16">
    <VBox spacing="2">
        <Label text="Ajustes" styleClass="page-title"/>
        <Label text="Elige qué quieres configurar."
               styleClass="page-subtitle"/>
    </VBox>

    <HBox fx:id="sectionNavigation" spacing="14" alignment="CENTER_LEFT" visible="false" managed="false">
        <Button text="← Todos los ajustes" onAction="#showOverview" styleClass="secondary-button"/>
        <Label fx:id="sectionTitle" styleClass="settings-section-title"/>
    </HBox>
    <ScrollPane fx:id="settingsScroll" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="settings-scroll">
        <VBox spacing="14">
            <GridPane fx:id="settingsMenu" hgap="18" vgap="18">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
            </GridPane>
            <VBox fx:id="detectionPanel" styleClass="settings-panel" spacing="12">
                <Label text="Detección de cambios frecuentes" styleClass="usage-title"/>
                <Label text="Estos valores deciden cuándo Deriva registra un episodio de cambios entre aplicaciones o sitios y cuándo lo cierra. No miden concentración ni productividad."
                       styleClass="settings-help" wrapText="true"/>
                <Label text="Solo cuentan los cambios confirmados; los cambios de menos de 3 s no cuentan."
                       styleClass="settings-note" wrapText="true"/>

                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="settings-row">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Cambios para abrir un episodio" styleClass="settings-label"/>
                        <Label text="Cuántos cambios entre aplicaciones o sitios deben ocurrir para abrir un episodio."
                               styleClass="settings-help" wrapText="true"/>
                    </VBox>
                    <HBox spacing="8" alignment="CENTER_RIGHT" minWidth="190">
                        <TextField fx:id="switchesField" minWidth="90" prefWidth="90" styleClass="settings-input"/>
                        <Label text="cambios" styleClass="settings-unit"/>
                    </HBox>
                </HBox>

                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="settings-row">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Ventana de tiempo" styleClass="settings-label"/>
                        <Label text="Los cambios deben ocurrir dentro de este periodo, contado hacia atrás desde el último cambio."
                               styleClass="settings-help" wrapText="true"/>
                    </VBox>
                    <HBox spacing="8" alignment="CENTER_RIGHT" minWidth="300">
                        <TextField fx:id="windowField" minWidth="90" prefWidth="90" styleClass="settings-input"/>
                        <Label text="segundos" styleClass="settings-unit"/>
                        <Label fx:id="windowHint" text="—" styleClass="settings-hint"/>
                    </HBox>
                </HBox>

                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="settings-row">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Tiempo en el mismo contexto para comprobar estabilidad"
                               styleClass="settings-label"/>
                        <Label text="Cuánto debe mantenerse la misma aplicación o sitio, sin un cambio pendiente, para comprobar la estabilidad. Se cuenta desde que empezó ese contexto."
                               styleClass="settings-help" wrapText="true"/>
                    </VBox>
                    <HBox spacing="8" alignment="CENTER_RIGHT" minWidth="300">
                        <TextField fx:id="stabilityField" minWidth="90" prefWidth="90" styleClass="settings-input"/>
                        <Label text="segundos" styleClass="settings-unit"/>
                        <Label fx:id="stabilityHint" text="—" styleClass="settings-hint"/>
                    </HBox>
                </HBox>

                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="settings-row">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Tiempo sin teclado ni ratón para considerar inactividad"
                               styleClass="settings-label"/>
                        <Label text="Al superar este tiempo sin teclado ni ratón, Deriva considera la actividad inactividad. También puede afectar al tiempo en primer plano de Uso diario; si lo aumentas demasiado, puede contar tiempo en que te alejaste del equipo."
                               styleClass="settings-help" wrapText="true"/>
                    </VBox>
                    <HBox spacing="8" alignment="CENTER_RIGHT" minWidth="300">
                        <TextField fx:id="idleField" minWidth="90" prefWidth="90" styleClass="settings-input"/>
                        <Label text="segundos" styleClass="settings-unit"/>
                        <Label fx:id="idleHint" text="—" styleClass="settings-hint"/>
                    </HBox>
                </HBox>
            </VBox>

            <VBox fx:id="passivePanel" styleClass="settings-panel" spacing="12">
                <Label text="Actividad pasiva" styleClass="usage-title"/>
                <Label text="Si un contexto tiene un objetivo pasivo y sigue en primer plano sin teclado ni ratón, Deriva puede seguir contándolo hasta este máximo desde la última entrada. No se aplica a contextos sin objetivo pasivo."
                       styleClass="settings-help" wrapText="true"/>
                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="settings-row">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Máximo de actividad pasiva" styleClass="settings-label"/>
                        <Label text="Tiempo máximo sin teclado ni ratón para seguir contando un contexto pasivo. Por defecto, 10 minutos."
                               styleClass="settings-help" wrapText="true"/>
                    </VBox>
                    <HBox spacing="8" alignment="CENTER_RIGHT" minWidth="300">
                        <TextField fx:id="passiveMaxField" minWidth="90" prefWidth="90" styleClass="settings-input"/>
                        <Label text="minutos" styleClass="settings-unit"/>
                        <Label fx:id="passiveMaxHint" text="—" styleClass="settings-hint"/>
                    </HBox>
                </HBox>
                <Label fx:id="passiveEffectiveValues" text="En uso ahora: —" styleClass="settings-effective" wrapText="true"/>
                <Label fx:id="passivePendingValues" text="" styleClass="settings-pending" wrapText="true"/>
                <Label fx:id="passiveUnsavedLabel" text="Cambios sin guardar." styleClass="settings-pending" wrapText="true"/>
                <Label fx:id="passiveValidationLabel" text="" styleClass="settings-error" wrapText="true"/>
                <Label fx:id="passiveLoadWarningLabel" text="" styleClass="settings-error" wrapText="true"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="passiveRestoreButton" text="Restaurar 10 minutos"
                            styleClass="secondary-button"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="passiveSaveButton" text="Guardar máximo pasivo"
                            styleClass="primary-button"/>
                </HBox>
                <Label fx:id="passiveSaveStatus" text="" styleClass="save-status" wrapText="true"/>
            </VBox>

            <VBox fx:id="deferralPanel" styleClass="settings-panel" spacing="12">
                <Label text="Avisos durante una deriva" styleClass="usage-title"/>
                <Label text="Si un aviso de objetivo coincide con una deriva activa, Deriva espera a que termine o al máximo indicado. Después registra qué ocurrió; ese resultado es una observación, no una prueba de efecto."
                       styleClass="settings-help" wrapText="true"/>
                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="settings-row">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Máximo de espera de un aviso" styleClass="settings-label"/>
                        <Label text="Tiempo máximo que puede esperar un aviso mientras hay deriva. Por defecto, 5 minutos."
                               styleClass="settings-help" wrapText="true"/>
                    </VBox>
                    <HBox spacing="8" alignment="CENTER_RIGHT" minWidth="300">
                        <TextField fx:id="deferralMaxField" minWidth="90" prefWidth="90" styleClass="settings-input"/>
                        <Label text="minutos" styleClass="settings-unit"/>
                        <Label fx:id="deferralMaxHint" text="—" styleClass="settings-hint"/>
                    </HBox>
                </HBox>
                <Label fx:id="deferralEffectiveValues" text="En uso ahora: —" styleClass="settings-effective" wrapText="true"/>
                <Label fx:id="deferralPendingValues" text="" styleClass="settings-pending" wrapText="true"/>
                <Label fx:id="deferralUnsavedLabel" text="Cambios sin guardar." styleClass="settings-pending" wrapText="true"/>
                <Label fx:id="deferralValidationLabel" text="" styleClass="settings-error" wrapText="true"/>
                <Label fx:id="deferralLoadWarningLabel" text="" styleClass="settings-error" wrapText="true"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="deferralRestoreButton" text="Restaurar 5 minutos"
                            styleClass="secondary-button"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="deferralSaveButton" text="Guardar máximo de espera"
                            styleClass="primary-button"/>
                </HBox>
                <Label fx:id="deferralSaveStatus" text="" styleClass="save-status" wrapText="true"/>
            </VBox>

            <VBox fx:id="extensionPanel" styleClass="settings-panel" spacing="12">
                <Label text="Extensión del navegador" styleClass="usage-title"/>
                <Label text="Con la extensión, Deriva registra en qué sitio estás en Chrome o Brave (un solo perfil). Solo guarda el dominio, por ejemplo youtube.com; nunca la dirección completa, el título ni el contenido. Sin ella, el tiempo en el navegador queda excluido."
                       styleClass="settings-help" wrapText="true"/>
                <Label fx:id="extensionStatusLabel" text="—" styleClass="settings-effective" wrapText="true"/>
                <Label fx:id="extensionEnvironmentLabel" text="" styleClass="settings-warning" wrapText="true"/>

                <VBox spacing="4" styleClass="settings-row">
                    <Label text="1. Cargar la extensión en el navegador" styleClass="settings-label"/>
                    <Label text="Abre chrome://extensions (o brave://extensions), activa «Modo de desarrollador», pulsa «Cargar descomprimida» y elige esta carpeta:"
                           styleClass="settings-help" wrapText="true"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="extensionFolderLabel" text="—" styleClass="settings-note" wrapText="true" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="extensionOpenFolderButton" text="Abrir carpeta" styleClass="secondary-button"/>
                    </HBox>
                </VBox>

                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="settings-row">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="2. ID de la extensión" styleClass="settings-label"/>
                        <Label text="Cópialo de la tarjeta de «Deriva» en la página de extensiones: 32 letras entre la a y la p."
                               styleClass="settings-help" wrapText="true"/>
                    </VBox>
                    <TextField fx:id="extensionIdField" prefWidth="330" styleClass="settings-input goal-text-input"
                               promptText="abcdefghijklmnopabcdefghijklmnop"/>
                </HBox>

                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="settings-row">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="3. Token local" styleClass="settings-label"/>
                        <Label text="Genera un token y pégalo, junto con el puerto, en las opciones de la extensión (Detalles › Opciones de extensión). No lo compartas."
                               styleClass="settings-help" wrapText="true"/>
                    </VBox>
                    <TextField fx:id="extensionTokenField" prefWidth="330" editable="false"
                               styleClass="settings-input goal-text-input" promptText="Sin token"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_RIGHT">
                    <Button fx:id="extensionGenerateButton" text="Generar token" styleClass="secondary-button"/>
                    <Button fx:id="extensionCopyButton" text="Copiar token" styleClass="secondary-button"/>
                </HBox>

                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="settings-row">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Puerto" styleClass="settings-label"/>
                        <Label text="Puerto local que usan Deriva y la extensión. Déjalo en 47821 salvo que esté ocupado."
                               styleClass="settings-help" wrapText="true"/>
                    </VBox>
                    <TextField fx:id="extensionPortField" minWidth="90" prefWidth="90" styleClass="settings-input"/>
                </HBox>

                <Label text="Los cambios se aplican la próxima vez que pulses «Iniciar captura» (si la captura está activa, pulsa «Detener captura» y vuelve a iniciarla)."
                       styleClass="settings-note" wrapText="true"/>
                <Label fx:id="extensionValidationLabel" text="" styleClass="settings-error" wrapText="true"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="extensionClearButton" text="Quitar configuración" styleClass="secondary-button"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="extensionSaveButton" text="Guardar configuración" styleClass="primary-button"/>
                </HBox>
                <Label fx:id="extensionSaveStatus" text="" styleClass="save-status" wrapText="true"/>
            </VBox>

            <VBox fx:id="valuesPanel" styleClass="settings-panel" spacing="8">
                <Label text="Valores" styleClass="settings-section-title"/>
                <Label fx:id="effectiveValues" text="En uso ahora: —" styleClass="settings-effective" wrapText="true"/>
                <Label fx:id="pendingValues" text="" styleClass="settings-pending" wrapText="true"/>
                <Label fx:id="unsavedLabel" text="Cambios sin guardar." styleClass="settings-pending" wrapText="true"/>
                <Label fx:id="validationLabel" text="" styleClass="settings-error" wrapText="true"/>
                <Label fx:id="loadWarningLabel" text="" styleClass="settings-error" wrapText="true"/>
                <Label fx:id="idleWarningLabel" text="" styleClass="settings-warning" wrapText="true"/>
            </VBox>

            <VBox fx:id="applicationPanel" styleClass="settings-panel" spacing="8">
                <Label text="Cómo se aplica" styleClass="settings-section-title"/>
                <Label text="Guardar no cambia la captura en curso. Pausar y Reanudar conservan los valores de la sesión; Detener y volver a Iniciar aplica los valores guardados. No se recalculan episodios ni historial."
                       styleClass="settings-help" wrapText="true"/>
                <Label text="Estos ajustes no cambian las exclusiones ni el bridge. Un «Cierre por exclusión» depende de qué ventana tenía el foco o de si el navegador tenía un sitio autorizado; no de estos números. Tampoco miden concentración ni productividad."
                       styleClass="settings-note" wrapText="true"/>
            </VBox>
        </VBox>
    </ScrollPane>

    <VBox fx:id="detectionActions" spacing="8">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="restoreButton" text="Restaurar valores predeterminados"
                styleClass="secondary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="saveButton" text="Guardar" styleClass="primary-button"/>
    </HBox>
    <Label fx:id="saveStatus" text="" styleClass="save-status" wrapText="true"/>
    </VBox>
</VBox>
