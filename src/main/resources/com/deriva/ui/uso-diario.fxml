<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.deriva.ui.fx.EmUsageController"
      styleClass="content" spacing="18">
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="Uso" styleClass="page-title"/>
            <Label text="Tiempo de primer plano registrado en este equipo." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>

    </HBox>

    <FlowPane hgap="12" vgap="8">
        <Label text="Periodo" styleClass="filter-label"/>
        <ComboBox fx:id="periodCombo" prefWidth="160" styleClass="filter-control"/>
        <Label text="Desde" styleClass="filter-label"/>
        <DatePicker fx:id="datePicker" prefWidth="155" styleClass="filter-control"/>
        <Label text="Hasta" styleClass="filter-label"/>
        <DatePicker fx:id="endDatePicker" prefWidth="155" styleClass="filter-control"/>
    </FlowPane>
    <Label fx:id="rangeLabel" styleClass="data-note"/>
    <HBox spacing="16">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="Tiempo en primer plano" styleClass="stat-label"/>
            <Label fx:id="totalLabel" text="—" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
            <Label text="Registro y cobertura" styleClass="stat-label"/>
            <Label fx:id="coverageLabel" text="—" styleClass="coverage-value" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label fx:id="zoneLabel" styleClass="data-note"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="sourceLabel" styleClass="data-note"/>
    </HBox>

    <Label text="Los sitios están incluidos en el tiempo de sus navegadores." styleClass="usage-note"/>
    <Label text="Solo cuenta el primer plano observado; inactividad, exclusiones y huecos no suman." styleClass="usage-note"/>

    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <VBox styleClass="usage-panel" HBox.hgrow="ALWAYS" spacing="10">
            <Label text="Aplicaciones" styleClass="usage-title"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="usage-scroll">
                <VBox fx:id="appsList" spacing="8"/>
            </ScrollPane>
        </VBox>

        <VBox styleClass="usage-panel" HBox.hgrow="ALWAYS" spacing="10">
            <Label text="Sitios" styleClass="usage-title"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="usage-scroll">
                <VBox fx:id="sitesList" spacing="8"/>
            </ScrollPane>
        </VBox>
    </HBox>

    <Label fx:id="statusLabel" text="Datos persistidos; el segmento abierto no se incluye."
           styleClass="usage-status" wrapText="true"/>
</VBox>
